# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# Data — the SQLite database is not source
data/
app/static/uploads/

# Build artifacts
build/
dist/
*.spec.bak

# Node
node_modules/

# macOS
.DS_Store

# Claude Code: memory, local settings, MCP config, preview config and agent
# worktrees — local state, kept private. CLAUDE.md itself is tracked: it is
# how this repository works, and an ignored file does not reach a fresh
# clone or an agent's worktree, where it is needed most.
.claude/
CLAUDE.local.md
.claude.json
.mcp.json

# Deployment secrets and data (deploy/README.md)
deploy/.env
deploy/backups/
deploy/certs/*
!deploy/certs/.gitkeep

# Launch clips, post packs and numbers (promo/README.md)
promo/out/

# Words kept out of what ships (tests/test_deploy.py), one a line
.private-words

