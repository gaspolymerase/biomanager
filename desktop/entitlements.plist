<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime's exceptions a PyInstaller app needs to run once
     signed and notarised (scripts/sign-macos.sh): Python's own libraries
     are loaded from inside the bundle and map memory it then runs. And the
     calendars, which a signed app may ask for only with the last key
     (Calendar → Mac Calendar, app/mac_calendar.py). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <key>com.apple.security.personal-information.calendars</key><true/>
</dict>
</plist>
