# HTTPS in front of BioManager. DOMAIN and TLS come from .env; TLS picks
# where the certificate comes from:
#
#   TLS=internal    Caddy's own CA (default; install its root on lab machines)
#   TLS=tailscale   a real certificate for a *.ts.net name, from the host's
#                   Tailscale (needs compose.tailscale.yaml; see deploy/README.md)
#   TLS=acme        Let's Encrypt, as ACME_EMAIL (needs public DNS and port 80)
#   TLS=files       a certificate from IT: deploy/certs/server.crt and server.key
#
# The ports are 80 and 443 unless .env says otherwise (host/ports.sh moves
# them when this machine already uses those); compose.yaml publishes them
# as the same numbers. The HTTPS one is in the site's address rather than
# https_port, so that Caddy's redirect from http:// keeps it when it isn't 443.
{
	http_port {$HTTP_PORT:80}
}

(tls_internal) {
	tls internal
}

# Nothing to say: Caddy fetches certificates for *.ts.net names from the
# host's Tailscale by itself. An explicit `tls { get_certificate tailscale }`
# would also switch on Let's Encrypt for the name, which can never succeed
# for a private tailnet name and only runs into rate limits.
(tls_tailscale) {
}

(tls_acme) {
	tls {$ACME_EMAIL}
}

(tls_files) {
	tls /certs/server.crt /certs/server.key
}

{$DOMAIN}:{$HTTPS_PORT:443} {
	import tls_{$TLS:internal}
	encode zstd gzip

	request_body {
		max_size 64MB
	}

	# Strict-Transport-Security comes from the app, which leaves it out on
	# a port other than 443: there this name is shared with the machine's
	# own pages, and it would make browsers insist on HTTPS for those too.
	header -Server

	reverse_proxy app:8000 {
		# Only the internet-facing site below may say a request came from the internet.
		header_up -X-BioManager-Entry
	}
}

# Internet access (deploy/host/internet-access.sh): Tailscale Funnel takes
# HTTPS on {$DOMAIN}:8443 from anywhere and forwards it here, on a port only
# the host can reach (compose.yaml publishes it on 127.0.0.1). Every request
# is marked as coming from the internet, and the app shows anyone not signed
# in only its guest-code page (app/guests.py).
http://:8081 {
	encode zstd gzip

	request_body {
		max_size 64MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy app:8000 {
		header_up X-BioManager-Entry internet
		header_up Host {$DOMAIN}:8443
		header_up X-Forwarded-Host {$DOMAIN}:8443
		header_up X-Forwarded-Proto https
	}
}
