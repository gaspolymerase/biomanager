# Copy to .env (next to compose.yaml) and fill in. Keep it readable by you only:
#   chmod 600 .env

# The name people type to reach BioManager, e.g. biomanager.mylab.example.edu,
# or the server's Tailscale name, e.g. biomanager.tail1234.ts.net
DOMAIN=biomanager.example.edu

# Where the HTTPS certificate comes from (see Caddyfile):
#   internal   Caddy's own CA; install its root certificate on lab machines
#   tailscale  a real certificate for the *.ts.net name (also set COMPOSE_FILE below)
#   acme       Let's Encrypt for ACME_EMAIL (public DNS and port 80 needed)
#   files      deploy/certs/server.crt and server.key from your IT department
TLS=internal
ACME_EMAIL=
# With TLS=tailscale, uncomment so Caddy can reach the host's Tailscale:
#COMPOSE_FILE=compose.yaml:compose.tailscale.yaml

# The ports BioManager listens on: 80 and 443 when unset. host/ports.sh
# fills these in before the first start, choosing others when this machine
# already uses 80 or 443 (a NAS's own web pages often do); people then type
# the port too, e.g. https://nas.local:4443. Don't use 8443 (Tailscale
# Funnel's). FUNNEL_PORT is local only, for host/internet-access.sh.
#HTTP_PORT=80
#HTTPS_PORT=443
#FUNNEL_PORT=8081

# Letters and digits only (it goes into a URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional. Unset, a key is made on first start and kept on the app volume.
# If you set it: 32+ random characters, and never change it casually —
# sessions end and saved Google Calendar links must be reconnected.
SECRET_KEY=

TZ=America/New_York
BACKUP_TIME=02:30
KEEP_LOCAL=30
# Where local backup copies go on this server (a different disk if you can).
BACKUP_DIR=./backups
# 1 = Monday … 7 = Sunday: the day the latest backup is test-restored.
RESTORE_TEST_WEEKDAY=7

# Off-site copies with restic (encrypted before they leave). Examples:
#   RESTIC_REPOSITORY=s3:https://s3.amazonaws.com/my-lab-backups/biomanager
#   RESTIC_REPOSITORY=sftp:backup@storage.example.edu:/biomanager
# Keep RESTIC_PASSWORD somewhere other than this server: without it the
# off-site copies cannot be read.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# A dead-man's switch (e.g. healthchecks.io): pinged after every good
# backup, so you are told when backups STOP, not only when one fails.
HEALTHCHECK_PING_URL=

# Sign in with Google or Microsoft (optional; see deploy/README.md).
# Redirect URI to register: https://DOMAIN/auth/google/callback
#                       and https://DOMAIN/auth/microsoft/callback
BIOMANAGER_GOOGLE_CLIENT_ID=
BIOMANAGER_GOOGLE_CLIENT_SECRET=
BIOMANAGER_MICROSOFT_CLIENT_ID=
BIOMANAGER_MICROSOFT_CLIENT_SECRET=
# common (any account) | organizations (work/school only) | a tenant ID
BIOMANAGER_MICROSOFT_TENANT=common

# Your institution's own sign-in, by OpenID Connect (Okta, Keycloak, Azure AD,
# Shibboleth's OIDC plugin…). Redirect URI: https://DOMAIN/auth/institution/callback
BIOMANAGER_OIDC_ISSUER=
BIOMANAGER_OIDC_CLIENT_ID=
BIOMANAGER_OIDC_CLIENT_SECRET=
# What the button says, e.g. CampusKey
BIOMANAGER_OIDC_NAME=
# A university in InCommon or eduGAIN, through CILogon (cilogon.org/oauth2/register).
# Redirect URI: https://DOMAIN/auth/cilogon/callback. IDP: the university's entityID (optional).
BIOMANAGER_CILOGON_CLIENT_ID=
BIOMANAGER_CILOGON_CLIENT_SECRET=
BIOMANAGER_CILOGON_IDP=

# enforce | report-only (log what the browser policy would block) | off
BIOMANAGER_CSP=enforce

# Once a day BioManager sends its makers anonymous counts (version, members as
# a range, which databases are on; never names). The Usage report shows exactly
# what. 0 turns it off for this server, whatever Lab setup says.
BIOMANAGER_TELEMETRY=

# Once a day the server asks GitHub whether a newer BioManager is out (sending
# only its version) and tells its admins. 0 turns that off; Update now in
# Settings → Devices & copies still works.
BIOMANAGER_UPDATE_CHECK=

# Reminder emails (see the main README).
BIOMANAGER_SMTP_HOST=
BIOMANAGER_SMTP_PORT=587
BIOMANAGER_SMTP_USER=
BIOMANAGER_SMTP_PASSWORD=
